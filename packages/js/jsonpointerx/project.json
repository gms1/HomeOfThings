{
  "name": "jsonpointerx",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/js/jsonpointerx/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/jsonpointerx",
        "main": "packages/js/jsonpointerx/src/index.ts",
        "tsConfig": "packages/js/jsonpointerx/tsconfig.lib.json",
        "assets": [],
        "project": "packages/js/jsonpointerx/package.json",
        "compiler": "swc",
        "format": [
          "cjs",
          "esm"
        ],
        "sourceMap": true
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.ts",
          "package.json"
        ]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "changelog": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js jsonpointerx",
        "envFile": "build/.env"
      }
    },
    "version-bump": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/version-bump.js jsonpointerx {args.ver}",
        "envFile": "build/.env"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        },
        "build"
      ],
      "options": {
        "command": "node dist/build/src/publish.js jsonpointerx {args.mode}",
        "envFile": "build/.env"
      }
    },
    "changelog:write": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js jsonpointerx --write",
        "envFile": "build/.env"
      }
    }
  }
}
