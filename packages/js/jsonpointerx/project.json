{
  "name": "jsonpointerx",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/js/jsonpointerx/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "options": {
        "args": ["**/*.ts", "package.json"]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "changelog": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js jsonpointerx",
        "envFile": "build/.env"
      }
    },
    "version-bump": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/version-bump.js jsonpointerx {args.ver}",
        "envFile": "build/.env"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        },
        "build"
      ],
      "options": {
        "command": "node dist/build/src/publish.js jsonpointerx {args.mode}",
        "envFile": "build/.env"
      }
    },
    "changelog:write": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js jsonpointerx --write",
        "envFile": "build/.env"
      }
    }
  }
}
