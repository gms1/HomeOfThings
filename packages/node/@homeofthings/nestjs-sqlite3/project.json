{
  "name": "nestjs-sqlite3",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/node/@homeofthings/nestjs-sqlite3/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/@homeofthings/nestjs-sqlite3",
        "tsConfig": "packages/node/@homeofthings/nestjs-sqlite3/tsconfig.lib.json",
        "packageJson": "packages/node/@homeofthings/nestjs-sqlite3/package.json",
        "main": "packages/node/@homeofthings/nestjs-sqlite3/src/index.ts",
        "assets": [
          "packages/node/@homeofthings/nestjs-sqlite3/*.md",
          "packages/node/@homeofthings/nestjs-sqlite3/LICENSE"
        ]
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.ts",
          "package.json"
        ]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "changelog": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js nestjs-sqlite3",
        "envFile": "build/.env"
      }
    },
    "version-bump": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/version-bump.js nestjs-sqlite3 {args.ver}",
        "envFile": "build/.env"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        },
        "build"
      ],
      "options": {
        "command": "node dist/build/src/publish.js nestjs-sqlite3 {args.mode}",
        "envFile": "build/.env"
      }
    },
    "changelog:write": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "build",
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/build/src/changelog.js nestjs-sqlite3 --write",
        "envFile": "build/.env"
      }
    }
  }
}
