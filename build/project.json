{
  "name": "build",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "build/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/build",
        "tsConfig": "build/tsconfig.lib.json",
        "packageJson": "build/package.json",
        "main": "build/src/index.ts",
        "assets": []
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "merge-coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/build/src/merge-coverage.js",
        "envFile": "build/.env"
      }
    },
    "validate-projects": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/build/src/validate-projects.js",
        "envFile": "build/.env"
      }
    },
    "changelog": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/build/src/changelog.js build",
        "envFile": "build/.env"
      }
    },
    "version-bump": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/build/src/version-bump.js build {args.ver}",
        "envFile": "build/.env"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/build/src/publish.js build {args.mode}",
        "envFile": "build/.env"
      }
    }
  }
}
